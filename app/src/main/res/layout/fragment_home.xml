<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#243A8F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="bottom"
                android:padding="20dp">

                <TextView
                    android:text="TECHINSTHUB"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:text="Находите проекты и работайте с преподавателями без лишних сложностей"
                    android:textColor="#DDFFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    tools:ignore="HardcodedText" />

                <Button
                    android:text="Перейти к проектам"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#F4B400"
                    android:textColor="@android:color/black"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@android:color/white">

                <TextView
                    android:text="УСЛУГИ"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#1E2F7A"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="20dp"
                    tools:ignore="HardcodedText" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="1">

                    <include
                        android:id="@+id/btnProjects"
                        layout="@layout/item_custom_button"
                        android:layout_height="60dp"
                        android:text="Проекты"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="15dp"
                        android:textAlignment="textStart"
                        android:layout_columnWeight="1"
                        tools:ignore="HardcodedText" />

                    <include
                        android:id="@+id/btnInternShips"
                        layout="@layout/item_custom_button"
                        android:layout_height="60dp"
                        android:text="Стажировки"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAlignment="textStart"
                        android:layout_columnWeight="1"
                        tools:ignore="HardcodedText" />

                    <include
                        android:id="@+id/btnEvents"
                        layout="@layout/item_custom_button"
                        android:layout_height="60dp"
                        android:text="Мероприятия"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAlignment="textStart"
                        android:layout_columnWeight="1"
                        tools:ignore="HardcodedText" />

                    <include
                        android:id="@+id/btnCommunity"
                        layout="@layout/item_custom_button"
                        android:layout_height="60dp"
                        android:text="Сообщество"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAlignment="textStart"
                        android:layout_columnWeight="1"
                        tools:ignore="HardcodedText" />
                </GridLayout>

                <TextView
                    android:text="РЕКОМЕНДАЦИИ"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#1E2F7A"
                    android:layout_marginTop="50dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    tools:ignore="HardcodedText" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRecommendationProjects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="смотреть все"
                    android:textColor="@color/black"
                    android:gravity="end"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:text="НАШИ НОВОСТИ"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:paddingStart="8dp"
            android:paddingEnd="0dp"
            android:layout_marginTop="50dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            tools:ignore="HardcodedText" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRecommendationNews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="смотреть все"
            android:textColor="@color/black"
            android:gravity="end"
            tools:ignore="HardcodedText" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>