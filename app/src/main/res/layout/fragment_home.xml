<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#243A8F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#243A8F" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="bottom"
                android:padding="24dp">

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="TECHINSTHUB"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/roboto_style"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Находите проекты и работайте с преподавателями без лишних сложностей"
                    android:textColor="#DDFFFFFF"
                    android:textSize="15sp"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="@font/inter_medium"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoToProjects"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:layout_gravity="end"
                    android:text="Перейти к проектам"
                    android:textColor="#1E2F7A"
                    android:backgroundTint="#FFCC00"
                    app:cornerRadius="24dp"
                    style="@style/Widget.MaterialComponents.Button" />

            </LinearLayout>
        </FrameLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="40dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@android:color/white">

                <TextView
                    android:text="УСЛУГИ"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#1E2F7A"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="20dp"
                    tools:ignore="HardcodedText"
                    android:fontFamily="@font/roboto_style"/>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="1">

                    <include
                        android:id="@+id/btnProjects"
                        layout="@layout/item_custom_button"
                        android:layout_height="60dp"
                        android:text="Проекты"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="15dp"
                        android:textAlignment="textStart"
                        android:layout_columnWeight="1"
                        tools:ignore="HardcodedText" />

                    <include
                        android:id="@+id/btnInternShips"
                        layout="@layout/item_custom_button"
                        android:layout_height="60dp"
                        android:text="Стажировки"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAlignment="textStart"
                        android:layout_columnWeight="1"
                        tools:ignore="HardcodedText" />

                    <include
                        android:id="@+id/btnEvents"
                        layout="@layout/item_custom_button"
                        android:layout_height="60dp"
                        android:text="Мероприятия"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAlignment="textStart"
                        android:layout_columnWeight="1"
                        tools:ignore="HardcodedText" />

                    <include
                        android:id="@+id/btnCommunity"
                        layout="@layout/item_custom_button"
                        android:layout_height="60dp"
                        android:text="Сообщество"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAlignment="textStart"
                        android:layout_columnWeight="1"
                        tools:ignore="HardcodedText" />
                </GridLayout>

                <TextView
                    android:text="РЕКОМЕНДАЦИИ"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#1E2F7A"
                    android:layout_marginTop="50dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    tools:ignore="HardcodedText"
                    android:fontFamily="@font/roboto_style"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRecommendationProjects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="смотреть все"
                    android:layout_gravity="end"
                    android:paddingBottom="30dp"
                    android:textColor="@color/black"
                    android:gravity="end"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:text="НАШИ НОВОСТИ"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:paddingStart="18dp"
            android:paddingEnd="0dp"
            android:layout_marginTop="60dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            tools:ignore="HardcodedText"
            android:fontFamily="@font/roboto_style"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRecommendationNews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:overScrollMode="never"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="смотреть все"
            android:textColor="@color/white"
            android:gravity="end"
            tools:ignore="HardcodedText" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>